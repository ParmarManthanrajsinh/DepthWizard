# ==============================================================================
# DepthWizard Configuration & Environment Variables
# ==============================================================================

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Compute Device (auto-detected if blank: "cuda" if PyTorch CUDA available else "cpu")
DEVICE=

# Depth Foundation Model Backbone
DEPTH_MODEL_NAME=depth-anything/Depth-Anything-V2-Small-hf
USE_MOCK_MODEL=false

# Fine-Tuned Model Checkpoint Path (optional, auto-detected in results/best_checkpoint.pt)
CKPT_PATH=results/best_checkpoint.pt

# Dataset Roots (ISPRS Benchmarks)
POTSDAM_ROOT=data/potsdam_raw
VAIHINGEN_ROOT=data/vaihingen_raw

# ML Training & DataLoader Hyperparameters
DEFAULT_BATCH_SIZE=4
DEFAULT_NUM_WORKERS=0
MIN_PLAUSIBLE_ELEVATION=-500.0
MAX_PLAUSIBLE_ELEVATION=9000.0

# Geospatial API Keys (Optional)
OPENTOPOGRAPHY_API_KEY=
